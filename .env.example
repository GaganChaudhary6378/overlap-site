# Public Supabase project configuration. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Production origin used for Supabase email redirects.
# Leave unset locally to use the current localhost origin.
NEXT_PUBLIC_SITE_URL=
